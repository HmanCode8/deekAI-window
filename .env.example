# ============ DeekAI 桌面版配置文件（与网页版保持同一套变量） ============
# 配置优先级：本文件 / 应用目录 .env < 应用数据目录 config.json（应用内设置页写入）
# 说明：把任意键写入本文件即可生效；在应用「设置」里填写会覆盖同名键。

# DeepSeek API Key（敏感，请勿提交到仓库）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# 可选：模型兜底（聊天时选择器里没有的模型名可作为兜底）
DEEPSEEK_MODEL=deepseek-v4-flash

# ---- 数据存储开关 ----
# 取值: memory（仅本次运行内存，关闭即丢） | supabase（持久化到数据库，需配置下方三项）
# 留空时：若已配置 SUPABASE_URL + SUPABASE_ANON_KEY 则按 supabase 处理，否则按 memory
DATA_STORE=supabase

# Supabase 连接信息（与网页版同一个项目时数据互通）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# 仅用于「老数据认领」等一次性系统操作，不进入业务读写路径，可不填
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
