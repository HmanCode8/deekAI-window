# ============ DeekAI 配置文件（开发/自托管） ============
# 说明：
# - 面向普通用户的发行版，后端配置请写在 app-config.json（见 app-config.example.json），随安装包内置
# - 本文件 .env 主要用于本地开发 / 自托管部署（网页端服务端同样读取本文件）
# - 用户级配置（模型 Key、主题、头像）由应用内设置页保存到本机 config.json

# ---- 运行版本 ----
# release = 面向普通用户（隐藏后端基础设施配置）；advanced = 自托管/开发者版（保留完整设置面板）
# 优先级：启动环境变量 > 本文件 > 随包内置的 app-config.json；都不设置时默认 release
# 本地开发若已存在 app-config.json（release），可在本文件写 advanced 打开完整设置面板
DEEKAI_EDITION=advanced

# ---- 模型（多模型 / BYOK）----
# 常规用法是在应用内「设置 → 模型设置」里添加条目：条目存在本机 localStorage（按账号隔离），
# 不写入服务端配置文件。下面几个键是「运营方预置条目」，填了会对所有使用者共享且只读，一般留空。
# 可选：服务方统一出 Key 时填写；留空则用户自带（纯 BYOK）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# 模型服务地址（OpenAI 兼容），默认 DeepSeek 官方
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 内置条目使用的模型
DEEPSEEK_MODEL=deepseek-chat

# 批量预置多条模型（JSON 数组字符串，一般不在这里配，用应用内设置界面更直观）
# 字段：id / name（自定义显示名）/ providerId（deepseek、openai、dashscope、moonshot、zhipu、siliconflow、openrouter、doubao、custom）
#       / baseUrl / model（厂商真实模型名）/ apiKey
# MODEL_PROFILES=[{"id":"p1","name":"我的 GPT-4o","providerId":"openai","baseUrl":"https://api.openai.com/v1","model":"gpt-4o","apiKey":"sk-xxx"}]
# 默认使用哪条（填条目 id）；留空则自动取第一条配好 Key 的
# DEFAULT_MODEL_PROFILE=p1

# ---- 数据存储开关 ----
# 取值: memory（仅本次运行内存，关闭即丢） | supabase（持久化到数据库，需配置下方三项）
# 留空时：若已配置 SUPABASE_URL + SUPABASE_ANON_KEY 则按 supabase 处理，否则按 memory
DATA_STORE=supabase

# Supabase 连接信息（运营方/自托管方提供；与网页版同一个项目时数据互通）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# 仅网页后端用于「老数据认领」等一次性系统操作，桌面端不需要
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 分享站点地址（网页端部署地址，用于拼接分享链接）
PUBLIC_WEB_URL=https://your-site.com

# ---- 网页端服务（可选，桌面端忽略这两项） ----
# 服务端口，默认 8787
PORT=8787
# 服务端可写目录：网页设置页保存的 config.json 与运行数据（默认 ./server-data）
SERVER_DATA_DIR=./server-data
