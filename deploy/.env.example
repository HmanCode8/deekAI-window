# ============ 服务器上的容器运行配置（模板） ============
# 用法：把本文件复制到项目根并命名为 .env（.env 已被 .gitignore 忽略）：
#   cp deploy/.env.example .env
#
# 这个文件同时被三处读取：
#   - deekai-api 容器：env_file 注入，作为应用的后端配置
#   - deekai-nginx 容器：env_file 注入，用 SITE_ADDRESS 渲染 nginx 站点配置
#   - （compose 内部的 ${} 变量替换只认同目录 .env，所以路径统一用相对的 ../.env）

# ---- 站点 ----
# 填「对外访问用的主机名」，Nginx 的 server_name 与证书路径都用它。
#
# 没有自己的域名、只有公网 IP 时，用 sslip.io：把 IP 写成带点或带横线的域名，
# 它会自动解析回这个 IP（无需注册、无需配 DNS）。例如服务器 IP 是 203.0.113.7：
#   SITE_ADDRESS=203.0.113.7.sslip.io
# 需要放行 80/443，Let's Encrypt 才能完成校验。sslip.io 配额不够时可换 nip.io（写法相同）。
SITE_ADDRESS=203.0.113.7.sslip.io

# 证书到期提醒邮箱（改成你自己的；只在证书快过期时收通知）
LE_EMAIL=admin@example.com

# ---- 运行版本 ----
# release = 面向普通用户（后端配置不可改，推荐）
# advanced = 自托管：可在应用内修改 Supabase 等基础设施配置
DEEKAI_EDITION=release

# ---- Supabase ----
# 与桌面端/网页版用同一个项目，则数据互通
DATA_STORE=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# 仅「老数据认领」用得到；不需要就留空
SUPABASE_SERVICE_ROLE_KEY=

# ---- 分享链接 ----
# 填最终对外访问的地址（含协议），桌面端拼分享链接会用它。
PUBLIC_WEB_URL=https://203.0.113.7.sslip.io
